# ==============================================
# SUREFIRE PLUMBING & HEATING — Environment Config
# Constitution Version: 2.0
# All geographic expansion controlled here
# ==============================================

# ===== APP =====
APP_ENV=development
APP_NAME=Surefire Plumbing & Heating
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== GEOGRAPHIC CONTROL — PRIMARY SWITCHES =====
DEFAULT_COUNTRY=UK
OPERATING_REGION=North West England
PRIMARY_SERVICE_AREA=North West England
REGION_EXPANSION_ENABLED=false

# Current Active Areas — North West England
LIVERPOOL_ENABLED=true
MERSEYSIDE_ENABLED=true
CHESHIRE_ENABLED=true
RUNCORN_ENABLED=true
WIDNES_ENABLED=true
WARRINGTON_ENABLED=true
ST_HELENS_ENABLED=true

# Greater Manchester — SELECTED POSTCODES only
GREATER_MANCHESTER_ENABLED=true
GREATER_MANCHESTER_MODE=SELECTED_POSTCODES

# Future Expansion — DISABLED by default
YORKSHIRE_ENABLED=false
WEST_MIDLANDS_ENABLED=false
LONDON_ENABLED=false
SCOTLAND_ENABLED=false
WALES_ENABLED=false

# ===== BUSINESS RULES =====
TRADER_NETWORK_ENABLED=true
TRADER_NETWORK_REGION=North West England
BOOKING_OUTSIDE_SERVICE_AREA=REJECT
MAX_PHOTOS_PER_BOOKING=9

# ===== DATABASE =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/surefire_plumbing

# ===== EXTERNAL SERVICES =====
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=surefire-uploads